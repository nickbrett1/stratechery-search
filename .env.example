# Environment variables for stratechery-search (docker-container)
# Generated by genproj. Copy to `.env` next to docker-compose.yml and fill in
# real values (genproj never commits secrets).
#
# Keys are derived from the docker-container `envVars` configuration; nothing
# is invented here.

ARCHIVE_ROOT=/archive
DATA_ROOT=/data
INDEX_PATH=/data/index/search.sqlite
# The synonym table is baked into the image from the repository (a reviewable
# artifact, not appdata). Override only to point at a different file.
VOCAB_PATH=/app/vocab.yaml
PORT=8080
