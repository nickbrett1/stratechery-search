# Multi-stage image for stratechery-search
# Generated by genproj (docker-container capability, language-aware). Adjust
# for your application.
#
# Stage 1 (build): copies the full source tree, installs dependencies and
# builds the application. Stage 2 (runtime): copies only the build output /
# virtualenv and production dependencies, keeping the final image small.

# Frontend stage: builds the Svelte app before the python build below.
# The python image has no node, so this is a separate stage rather than a
# step in the main one. Output lands in web/dist/
# (see web/README.md).
FROM node:22-bookworm AS frontend
WORKDIR /app
COPY web/package.json web/package-lock.json* web/.npmrc* ./
RUN PINNED_NPM="$(node -p "try{require('./package.json').packageManager}catch(e){''}" 2>/dev/null || true)" \
    && if [ -n "$PINNED_NPM" ] && [ "$(npm --version)" != "${PINNED_NPM#npm@}" ]; then \
         echo "Activating pinned ${PINNED_NPM}..."; \
         npm install -g "${PINNED_NPM}" >/dev/null || true; \
       fi \
    && if [ -f package-lock.json ]; then npm ci; else npm install; fi
COPY web/. .
RUN npm run build

FROM python:3.12-slim AS build
WORKDIR /app
COPY . .
RUN python -m venv /opt/venv \
    && /opt/venv/bin/pip install --upgrade pip \
    && if [ -f requirements.txt ]; then \
         grep -vE '^\s*(-e|--editable)\s+\.' requirements.txt > /tmp/reqs.txt || true; \
         [ -s /tmp/reqs.txt ] && /opt/venv/bin/pip install --no-cache-dir -r /tmp/reqs.txt; \
       fi \
    && if [ -f pyproject.toml ]; then \
         /opt/venv/bin/pip install --no-cache-dir .; \
       fi
COPY --from=frontend /app/dist ./web/dist

FROM python:3.12-slim
WORKDIR /app
# Link the GHCR container package to its GitHub repo on push. GHCR auto-links
# the package to nickbrett1/stratechery-search so it inherits the
# repo's access (public repo -> public package; no manual visibility step).
LABEL org.opencontainers.image.source=https://github.com/nickbrett1/stratechery-search
RUN apt-get update && apt-get install -y --no-install-recommends sqlite3 curl \
    && rm -rf /var/lib/apt/lists/*
ENV PATH="/opt/venv/bin:$PATH"
COPY --from=build /opt/venv /opt/venv
COPY . .
# The query-time synonym table, copied explicitly rather than left to `COPY . .`
# above: the image must fail to build if the file is missing, because a shipped
# image without it answers /healthz with `vocab: {terms: 0}` and looks healthy.
# VOCAB_PATH defaults to `vocab.yaml` relative to WORKDIR (/app), i.e. this copy.
COPY vocab.yaml ./vocab.yaml
# The gazetteer, copied explicitly for the same reason. The facet index is built
# from this file, and the file is what decides which companies exist — an image
# without it can still serve (the API omits `by_entity`), but it cannot rebuild
# the index, and `build_facets` would fail only on ryzen, at deploy time.
COPY entities.yaml ./entities.yaml
COPY --from=frontend /app/dist ./web/dist
EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=10s --start-period=10s \
  CMD curl -fsS "http://127.0.0.1:${PORT:-8080}/livez" || exit 1
CMD ["python", "-m", "stratechery_search"]
